{
  "name": "mesa-support-desk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Bootstrap 5, SCSS, TypeScript, FastAPI and SQLite learning project for request management.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "dev:api": "VITE_MESA_STORAGE=api vite --host 0.0.0.0 --port 4173 --strictPort",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "build:api": "VITE_MESA_STORAGE=api tsc --noEmit && VITE_MESA_STORAGE=api vite build --outDir dist-api",
    "preview:api": "VITE_MESA_STORAGE=api vite preview --outDir dist-api --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:api": "bash scripts/test-api-e2e.sh"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bootstrap": "5.2.11",
    "@types/node": "22.20.2",
    "sass": "1.107.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
